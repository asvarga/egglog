(edge v5 v15)
(edge v5 v25)
(edge v5 v35)
(edge v5 v45)
(edge v15 v5)
(edge v15 v25)
(edge v15 v35)
(edge v15 v45)
(edge v25 v5)
(edge v25 v15)
(edge v25 v35)
(edge v25 v45)
