(edge v35 v15)
(edge v35 v25)
(edge v35 v45)
(edge v45 v5)
(edge v45 v15)
(edge v45 v25)
(edge v45 v35)

; Transitive closure rule (this will create many derived facts)
(rule ((edge x y))
    ((path x y)))

(rule ((path x y) (path y z))
    ((path x z)))

; Run saturation multiple times to stress the system
(run 50)

; Print sizes to see the complexity
(print-size edge)
(print-size path)

; Extensive checking to stress fact lookup performance
(check (path v0 v49))
(check (path v49 v0))
(check (path v0 v25))
(check (path v25 v49))
(check (path v10 v40))
(check (path v40 v10))

