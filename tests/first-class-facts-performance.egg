; Test demonstrating regular egglog functionality
; Note: First-class facts functionality is currently available only at the Rust API level
; This test demonstrates the foundation that first-class facts are built upon

(datatype Vertex (V i64))

; Define a relation that will contain facts we can reference
(relation edge (Vertex Vertex))
(relation path (Vertex Vertex))

; Create a large number of facts to test performance
(let n1 (V 0))
(let n2 (V 1))
(let n3 (V 2))
(let n4 (V 3))
(let n5 (V 4))
(let n6 (V 5))
(let n7 (V 6))
(let n8 (V 7))
(let n9 (V 8))
(let n10 (V 9))

; Add many edge facts
(edge n1 n2)
(edge n2 n3)
(edge n3 n4)
(edge n4 n5)
(edge n5 n6)
(edge n6 n7)
(edge n7 n8)
(edge n8 n9)
(edge n9 n10)
(edge n10 n1)

; Add reverse edges
(edge n2 n1)
(edge n3 n2)
(edge n4 n3)
(edge n5 n4)
(edge n6 n5)
(edge n7 n6)
(edge n8 n7)
(edge n9 n8)
(edge n10 n9)
(edge n1 n10)

; Create more complex pattern to test fact reference performance
(let n11 (V 10))
(let n12 (V 11))
(let n13 (V 12))
(let n14 (V 13))
(let n15 (V 14))
(let n16 (V 15))
(let n17 (V 16))
(let n18 (V 17))
(let n19 (V 18))
(let n20 (V 19))

; Add more edges for stress testing
(edge n11 n12)
(edge n12 n13)
(edge n13 n14)
(edge n14 n15)
(edge n15 n16)
(edge n16 n17)
(edge n17 n18)
(edge n18 n19)
(edge n19 n20)
(edge n20 n11)

; Derive path relations (transitive closure)
(rule ((edge x y))
    ((path x y)))

(rule ((path x y) (path y z))
    ((path x z)))

; Test fact reference operations if supported
; (This will test the first-class facts functionality when available)

; Force evaluation
(run 10)

; Print some results to verify correctness
(print-size edge)
(print-size path)

; Check for specific paths to test fact resolution performance
(check (path n1 n10))
(check (path n1 n5))
(check (path n11 n20))

; Test multiple checks to stress fact lookup
(check (path n1 n2))
(check (path n2 n3))
(check (path n3 n4))
(check (path n4 n5))
(check (path n5 n6))
(check (path n6 n7))
(check (path n7 n8))
(check (path n8 n9))
(check (path n9 n10))
(check (path n10 n1))
